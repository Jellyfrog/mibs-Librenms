<!doctype html>
<html lang="en" data-root="{{ root }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}LibreNMS MIB Browser{% endblock %}</title>
<meta name="description" content="{% block description %}All SNMP MIBs in LibreNMS: OID trees, object types, descriptions and example values from test devices.{% endblock %}">
<link rel="canonical" href="{{ cfg.base_url }}{{ path }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="LibreNMS MIB Browser">
<meta property="og:title" content="{{ self.title() }}">
<meta property="og:description" content="{{ self.description() }}">
<meta property="og:url" content="{{ cfg.base_url }}{{ path }}">
<meta name="twitter:card" content="summary">
<link rel="icon" href="{{ root }}/assets/favicon.ico">
<link rel="stylesheet" href="{{ root }}/assets/style.css?v={{ asset_v }}">
<script>try{var t=localStorage.getItem("theme");if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
{% block head %}{% endblock %}
</head>
<body>
<header class="top"><div class="wrap">
  <a class="brand" href="{{ root }}/"><img class="logo logo-light" src="{{ root }}/assets/logo-light.svg" alt="LibreNMS" width="140" height="32"><img class="logo logo-dark" src="{{ root }}/assets/logo-dark.svg" alt="LibreNMS" width="140" height="32"><span>MIB Browser</span></a>
  <nav aria-label="Main"><a href="{{ root }}/mibs/">All MIBs</a><a href="{{ root }}/vendors/">Vendors</a><a href="{{ root }}/stats/">Statistics</a></nav>
  <form class="hsearch live" action="{{ root }}/search/" role="search"><label class="sr" for="hq">Find a MIB, object or OID</label><input id="hq" name="q" type="search" autocomplete="off" placeholder="MIB, object or OID" data-live></form>
  <button class="theme" type="button" aria-label="Change the color theme"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></button>
</div></header>
<main>{% block main %}{% endblock %}</main>
<footer><div class="wrap">This site uses the MIB files from <a href="https://github.com/librenms/librenms/tree/{{ cfg.librenms_sha }}/mibs">LibreNMS {{ cfg.librenms_sha[:7] }}</a>. Each MIB is the copyright of its owner. Updated {{ cfg.build_date }}. <a href="https://github.com/librenms/mibs.librenms.org">Source code of this site</a>.</div></footer>
<script src="{{ root }}/assets/search.js?v={{ asset_v }}" defer></script>
<script src="{{ root }}/assets/site.js?v={{ asset_v }}" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
